# 每台机器复制为 ~/.config/qwen35-cpro/decoder.env，或用 DECODER_ENV 指向个人配置。
# 同机多人可先读取管理员维护的本站公共配置，再在本文件覆盖个人项。
# source /srv/qwen35/site/decoder.env

# 个人项，两机选择相同模式与 phase。多人共用 root 服务账号时手填各自的目录名。
DECODER_MODE=40                     # linear | full | 4 | 40 | layerwise
DECODER_PHASE=prefill               # prefill (T64) | decode (T1)
# AI_RUN_DIR=/data/runs/alice/qwen35
# DECODER_RUN_ROOT="$AI_RUN_DIR/target/tests"
# CONDA_EXE=/opt/miniforge/bin/conda          # conda 已在 PATH 时可省略

# 78 公共项：可共用只读的原始源码、checkpoint、tokenizer 和软件安装。
# TARGET_SOURCE=/srv/qwen35/source/310p
# CPRO_SOURCE=/srv/qwen35/source/cpro
# DECODER_NZ_ENV=qwen3_5_w4                 # 支持 conda 名、绝对 prefix 或 current
# DECODER_EXPORT_ENV=qwen3_5_cpro
# DECODER_CANN_SETUP=/opt/ascend/ascend-toolkit/set_env.sh
# 若两个环境使用不同 CANN，可分别指定 DECODER_NZ_SETUP、DECODER_EXPORT_SETUP。

# 78 个人项：NZ_CONFIG 的 prompts[0] 决定输入。YAML 内模型和权重项可写共享绝对路径。
# NZ_CONFIG="$HOME/.config/qwen35-cpro/model.yaml"
# TARGET_CONFIG="$NZ_CONFIG"                 # 两个工程共用该 YAML 时
# CPRO_PATCHED_SOURCE=/data/work/alice/cpro-edit

# 35 公共项：初始化脚本在已选择的 conda 环境中运行。已初始化的环境可省略 setup。
# CPRO_DDK_ROOT=/srv/cpro/ddk_internal
# DECODER_DDK_SETUP="$CPRO_DDK_ROOT/tools/tools_ascendc/set_ascendc_env.sh"
# DECODER_BOARD_ENV=/opt/conda/envs/custom_pypto
# HDC=/opt/ohos/command-line-tools/sdk/default/openharmony/toolchains/hdc
# BIP=hdc-server:port
# SN=board-serial
# CPRO_BOARD_TOOL=/data/local/tmp/tools_sysdbg/model_run_tool_internal   # 板端路径
# 若个人 AI_RUN_DIR 下已有 runtime/runtime.json 和 common/tbe-diagnosis，可沿用默认值。
# RUNTIME_CONFIG=/srv/qwen35/runtime/runtime.json                        # 保留配套 assets
# TBE_DIAGNOSIS=/srv/qwen35/ddk-validation/tbe-diagnosis                 # 完整已验证目录
# OHOS_NATIVE_SDK=/opt/ohos/command-line-tools/sdk/default/openharmony/native  # 构建 runner 时

# 35 个人项：与本机目录不同时指向 78 上自己的 case 父目录。SSH 凭据由 transfer.json 管理。
# DECODER_REMOTE_RUN_ROOT=/data/runs/alice/qwen35/target/tests
# CPRO_TRANSFER_CONFIG=/data/config/alice/transfer.json      # 35，默认 ~/.config/qwen35-cpro/transfer.json
