# Copy to ~/.config/qwen35-cpro/decoder.env on each host.
# Fill in paths for that host, or keep using values exported by your environment.
DECODER_MODE=40                    # linear | full | 4 | 40 | layerwise
DECODER_PHASE=prefill              # prefill (T64) | decode (T1)
# AI_RUN_DIR=/path/to/run-storage
# DECODER_RUN_ROOT="$AI_RUN_DIR/target/tests"

# 78: 310P reference and CPro export
# TARGET_SOURCE=/path/to/310p-project
# CPRO_SOURCE=/path/to/original-cpro
# NZ_CONFIG="$TARGET_SOURCE/config/qwen3_5_moe.yaml"     # prompts[0]
# TARGET_CONFIG="$NZ_CONFIG"                             # if both projects use this YAML
# CPRO_PATCHED_SOURCE=/path/to/editable-cpro             # generated once, then used as-is
# DECODER_NZ_ENV=qwen3_5_w4
# DECODER_EXPORT_ENV=qwen3_5_cpro

# 35: load the DDK environment before running board
# CPRO_DDK_ROOT=/path/to/ddk_internal
# BIP=hdc-host:port
# SN=device-serial
# RUNTIME_CONFIG="$AI_RUN_DIR/runtime/runtime.json"
# TBE_DIAGNOSIS="$AI_RUN_DIR/common/tbe-diagnosis"
# DECODER_BOARD_ENV=custom_pypto
# DECODER_REMOTE_RUN_ROOT=/absolute/case-parent/on/78    # if different from this host
